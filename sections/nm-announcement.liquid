<div class="nm nm-announcement">
  <div class="nm-announcement__inner">
    {%- if section.settings.show_icon -%}
      {%- render 'nm-icon', icon: 'gift', class: 'nm-announcement__icon' -%}
    {%- endif -%}
    <p class="nm-announcement__text">
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      {{ section.settings.text }}
      {%- if section.settings.link != blank -%}</a>{%- endif -%}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "NM Announcement bar",
  "class": "nm-section-announcement",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "info": "Use bold for the highlighted price.",
      "default": "Summer Savings: Semaglutide for Just <strong>$169/mo</strong>. Any Dose!"
    },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "show_icon", "label": "Show gift icon", "default": true }
  ],
  "presets": [{ "name": "NM Announcement bar" }]
}
{% endschema %}
