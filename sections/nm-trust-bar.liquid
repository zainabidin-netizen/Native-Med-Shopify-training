{%- capture nm_trust_items -%}
  {%- for block in section.blocks -%}
    <li class="nm-trust__item" {{ block.shopify_attributes }}>
      {%- if block.settings.icon != blank -%}
        {{ block.settings.icon | image_url: width: 90 | image_tag: width: 45, height: 45, alt: '' }}
      {%- else -%}
        <img src="{{ block.settings.icon_default | append: '.svg' | asset_url }}" alt="" width="45" height="45">
      {%- endif -%}
      <span class="nm-trust__text">{{ block.settings.text | escape }}</span>
    </li>
  {%- endfor -%}
{%- endcapture -%}

<section class="nm nm-trust" aria-label="{{ section.settings.label | escape }}" style="--nm-marquee-duration: {{ section.settings.duration }}s;">
  <div class="nm-trust__track">
    <ul class="nm-trust__group">{{ nm_trust_items }}</ul>
    <ul class="nm-trust__group" aria-hidden="true">{{ nm_trust_items }}</ul>
  </div>
</section>

{% schema %}
{
  "name": "NM Trust bar",
  "class": "nm-section-trust",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why patients trust NativeMed" },
    { "type": "range", "id": "duration", "label": "Scroll duration", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Custom icon" },
        {
          "type": "select",
          "id": "icon_default",
          "label": "Icon",
          "options": [
            { "value": "nm-trust-medal", "label": "Medal" },
            { "value": "nm-trust-consult", "label": "Consultation" },
            { "value": "nm-trust-delivery", "label": "Delivery" },
            { "value": "nm-trust-approve", "label": "Approved" }
          ],
          "default": "nm-trust-medal"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Trust item" }
      ]
    }
  ],
  "presets": [{ "name": "NM Trust bar" }]
}
{% endschema %}
