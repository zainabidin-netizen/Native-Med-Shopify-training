<section class="nm nm-split nm-textured nm-textured--flip">
  <div class="nm-split__inner">
    <div class="nm-split__media{% if section.settings.mirror %} nm-split__media--mirror{% endif %}">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550, 800, 1100', sizes: '(min-width: 990px) 550px, 100vw', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'nm-sustainable.png' | asset_url }}" alt="" width="550" height="550" loading="lazy">
      {%- endif -%}
    </div>

    <div class="nm-split__content">
      {%- if section.settings.pill != blank -%}
        <p class="nm-pill nm-split__pill">{{ section.settings.pill | escape }}</p>
      {%- endif -%}
      <h2 class="nm-h2">{{ section.settings.heading | replace: ' | ', ' <br>' }}</h2>
      <ul class="nm-split__features">
        {%- for block in section.blocks -%}
          <li class="nm-split__feature" {{ block.shopify_attributes }}>
            <span class="nm-split__icon">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon | image_url: width: 60 | image_tag: width: 30, height: 30, alt: '' }}
              {%- else -%}
                <img src="{{ block.settings.icon_default | append: '.svg' | asset_url }}" alt="" width="30" height="30" loading="lazy">
              {%- endif -%}
            </span>
            <span class="nm-split__feature-text">{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}
        <a class="nm-btn nm-btn--primary nm-split__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NM Image with features",
  "class": "nm-section-split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "mirror", "label": "Mirror image horizontally", "default": true },
    { "type": "text", "id": "pill", "label": "Label", "default": "Popular" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic text is highlighted in purple. Use \" | \" for a line break.",
      "default": "Sustainable <em>Weight</em> | <em>Loss</em> Based On Biology"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "GET STARTED" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Custom icon" },
        {
          "type": "select",
          "id": "icon_default",
          "label": "Icon",
          "options": [
            { "value": "nm-feat-delivery", "label": "Delivery truck" },
            { "value": "nm-feat-consult", "label": "Consultation" },
            { "value": "nm-feat-certificate", "label": "Certificate" },
            { "value": "nm-feat-stamp", "label": "Stamp" }
          ],
          "default": "nm-feat-delivery"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Feature" }
      ]
    }
  ],
  "presets": [{ "name": "NM Image with features" }]
}
{% endschema %}
